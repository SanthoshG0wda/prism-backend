# ==========================================
# AI Provider: NVIDIA NIM (Recommended)
# Get your free key at: https://build.nvidia.com/
# ==========================================
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/muse-glimmer-30b
NVIDIA_API_KEY=nvapi-your-key-here

# Popular NVIDIA NIM Models:
# - meta/llama-3.3-70b-instruct (State of the art reasoning & analytics)
# - nvidia/llama-3.1-nemotron-70b-instruct (NVIDIA fine-tuned reasoning model)
# - meta/llama-3.1-70b-instruct
# - meta/llama-3.1-8b-instruct (Ultra-fast)
# - mistralai/mistral-large-2-instruct

# ==========================================
# Alternative Provider: OpenAI / Compatible
# ==========================================
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-openai-key-here

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8501

# Tool Execution Settings
MAX_QUERY_LIMIT=1000
SQL_TIMEOUT_SECONDS=10
ANOMALY_ZSCORE_THRESHOLD=3.0
